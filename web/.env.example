# Public values. Safe to expose, inlined into the browser bundle at build time.
NEXT_PUBLIC_SANITY_PROJECT_ID=3krwldhr
NEXT_PUBLIC_SANITY_DATASET=production

# Where the standalone Studio runs. Used for click-to-edit links.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Storefront price formatting.
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_LOCALE=en-IN

# Canonical origin of the storefront. Makes Open Graph image URLs absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
# Create a Viewer token at https://www.sanity.io/manage/project/3krwldhr/api
# Without it the site still works, but drafts and Presentation Tool do not.
SANITY_API_READ_TOKEN=

# Server-only. Editor-level token used to write orders, customers and
# enquiries into the private "commerce" dataset. Create it at
# https://www.sanity.io/manage/project/3krwldhr/api with the Editor role.
# Without it, checkout and the forms explain that ordering is not switched on.
SANITY_API_WRITE_TOKEN=

# Name of the private dataset holding orders and customers.
SANITY_COMMERCE_DATASET=commerce
